# KAMO Funding App — Environment Variables
# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (server-side only — never expose to client)
# Use KAMO_ prefix to avoid conflict with system OPENAI_API_KEY
KAMO_OPENAI_API_KEY=your_openai_api_key
KAMO_OPENAI_BASE_URL=https://api.openai.com/v1

# Email (Phase 1後半)
EMAIL_FROM=noreply@kamofunding.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
NEXT_PUBLIC_AI_TOOL_PASSWORD=your_ai_tool_password
RESEND_API_KEY=your_resend_api_key
